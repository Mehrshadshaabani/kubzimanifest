# Copy to deploy/.env and fill in. Never commit the real .env.

DOMAIN=api.yourdomain.com

# openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# Google Cloud Console -> Credentials -> OAuth client ID -> Web application
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://api.yourdomain.com/v1/auth/google/callback

# github.com/settings/developers -> New OAuth App
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=https://api.yourdomain.com/v1/auth/github/callback

# account.nowpayments.io (or account-sandbox.nowpayments.io) -> Store Settings
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_BASE=https://api.nowpayments.io
NOWPAYMENTS_CALLBACK_URL=https://api.yourdomain.com/v1/billing/webhook/nowpayments
